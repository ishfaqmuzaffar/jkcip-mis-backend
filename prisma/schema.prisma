generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Existing Enums (unchanged) ───────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DEPARTMENT_OFFICER
  DATA_ENTRY
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SchemeStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  ON_HOLD
}

enum BeneficiaryStatus {
  IDENTIFIED
  VERIFIED
  APPROVED
  SUPPORTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LogframeLevel {
  OUTREACH
  GOAL
  DEVELOPMENT_OBJECTIVE
  OUTCOME
  OUTPUT
  SUB_OUTPUT
  INDICATOR_GROUP
}

enum IndicatorDirection {
  INCREASE
  DECREASE
  MAINTAIN
}

enum IndicatorFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  BIENNIAL
  MID_TERM
  END_TERM
  AD_HOC
}

enum LandType {
  OWNED
  LEASED
  SHARECROPPER
  COMMON_LAND
}

// ─── NEW Enums ────────────────────────────────────────────────────────────────

enum BeneficiaryCategory {
  GENERAL
  SC
  ST
  OBC
  PHH
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REVERTED
}
enum AWPBStatus {
  DRAFT
  PIU_REVIEW
  PMU_REVIEW
  IFAD_SUBMISSION
  IFAD_APPROVED
  DPC_APPROVED
  DAP_APPROVED
  REJECTED
  RETURNED
}


// ─── Existing Models (unchanged) ──────────────────────────────────────────────

model User {
  id                 Int                     @id @default(autoincrement())
  fullName           String
  email              String                  @unique
  password           String
  role               UserRole                @default(VIEWER)
  status             UserStatus              @default(ACTIVE)
  department         String?
  phone              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  createdSchemes     Scheme[]                @relation("SchemeCreatedBy")
  createdProjects    Project[]               @relation("ProjectCreatedBy")
  createdApprovals   Approval[]              @relation("ApprovalRequestedBy")
  reviewedApprovals  Approval[]              @relation("ApprovalReviewedBy")
  verifiedIndicators IndicatorYearProgress[] @relation("IndicatorYearProgressVerifiedBy")
  createdBeneficiaries Beneficiary[]         @relation("BeneficiaryCreatedBy")
  awpbs                AWPB[]                  @relation("AWPBCreatedBy")
  awpbHistory          AWPBHistory[]            @relation("AWPBHistoryUser")
  mprConflicts         MprConflict[]            @relation("MprConflictResolver")
}

// ─── Scheme (added subComponentId) ───────────────────────────────────────────

model Scheme {
  id                    Int           @id @default(autoincrement())
  title                 String
  code                  String        @unique
  description           String?
  department            String
  status                SchemeStatus  @default(DRAFT)
  budget                Float         @default(0)
  utilizedBudget        Float         @default(0)
  targetBeneficiaries   Int           @default(0)
  achievedBeneficiaries Int           @default(0)
  startDate             DateTime?
  endDate               DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  createdById           Int?
  subComponentId        Int?                          // ← NEW
  createdBy             User?         @relation("SchemeCreatedBy", fields: [createdById], references: [id])
  subComponent          SubComponent? @relation(fields: [subComponentId], references: [id], onDelete: SetNull) // ← NEW
  projects              Project[]
  beneficiaries         Beneficiary[]
  awpbLines             AWPBLine[]

  @@index([department])
  @@index([status])
  @@index([subComponentId])                          // ← NEW
}

model Project {
  id               Int           @id @default(autoincrement())
  name             String
  code             String        @unique
  description      String?
  department       String
  district         String?
  block            String?
  village          String?
  status           ProjectStatus @default(PLANNED)
  priority         PriorityLevel @default(MEDIUM)
  budget           Float         @default(0)
  utilizedBudget   Float         @default(0)
  targetCount      Int           @default(0)
  achievedCount    Int           @default(0)
  beneficiaryCount Int           @default(0)
  latitude         Float?
  longitude        Float?
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  schemeId         Int?
  createdById      Int?
  scheme           Scheme?       @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  createdBy        User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  beneficiaries    Beneficiary[]
  approvals        Approval[]

  @@index([department])
  @@index([district])
  @@index([status])
  @@index([priority])
}

// ─── Beneficiary (added category + applicationStatus) ─────────────────────────

model Beneficiary {
  id                Int                   @id @default(autoincrement())
  
  // ── Identity ──────────────────────────────────────────────────
  fullName          String
  uhid              String?               @unique  // JKCIP-2026-SRN-000001
  referenceNumber   String                @unique
  aadhaarNumber     String?               // for deduplication (masked in UI)
  gender            String?
  age               Int?
  phone             String?
  
  // ── Location ──────────────────────────────────────────────────
  district          String?
  block             String?
  village           String?
  latitude          Float?               // GPS capture
  longitude         Float?
  
  // ── Land Holding ──────────────────────────────────────────────
  landHolding       Float?               // hectares
  landType          LandType?
  khasraNumber      String?              // survey/khasra number
  
  // ── FPO Linkage ───────────────────────────────────────────────
  fpoName           String?
  fpoMemberId       String?
  
  // ── Classification ────────────────────────────────────────────
  isYouth           Boolean               @default(false)
  isWoman           Boolean               @default(false)
  isBpl             Boolean               @default(false)
  isGeneral         Boolean               @default(false)
  category          BeneficiaryCategory   @default(GENERAL)
  applicationStatus ApplicationStatus     @default(PENDING)
  status            BeneficiaryStatus     @default(IDENTIFIED)
  
  // ── Financial ─────────────────────────────────────────────────
  sanctionedAmount  Float                 @default(0)
  
  // ── Meta ──────────────────────────────────────────────────────
  remarks           String?
  importBatchId     String?              // track bulk imports
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  schemeId          Int?
  projectId         Int?
  createdById       Int?
  approvedAt        DateTime?
  
  // ── Relations ─────────────────────────────────────────────────
  scheme            Scheme?               @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy         User?                 @relation("BeneficiaryCreatedBy", fields: [createdById], references: [id])
  surveyResponses   SurveyResponse[]

  @@index([district])
  @@index([status])
  @@index([category])
  @@index([applicationStatus])
  @@index([uhid])
  @@index([aadhaarNumber])
  @@index([importBatchId])
  @@index([isYouth])
  @@index([isWoman])
  @@index([isBpl])
}


model Approval {
  id            Int            @id @default(autoincrement())
  title         String
  referenceNo   String         @unique
  entityType    String
  department    String
  status        ApprovalStatus @default(PENDING)
  priority      PriorityLevel  @default(MEDIUM)
  remarks       String?
  dueDate       DateTime?
  decisionAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  entityId      Int?
  projectId     Int?
  requestedById Int?
  reviewedById  Int?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedBy   User?          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  reviewedBy    User?          @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id])

  @@index([department])
  @@index([status])
  @@index([priority])
}

// ─── Logframe (unchanged) ─────────────────────────────────────────────────────

model LogframeNode {
  id          Int            @id @default(autoincrement())
  title       String
  code        String         @unique
  level       LogframeLevel
  description String?
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parentId    Int?
  parent      LogframeNode?  @relation("LogframeNodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    LogframeNode[] @relation("LogframeNodeHierarchy")
  indicators  Indicator[]

  @@index([level])
  @@index([parentId])
  @@index([sortOrder])
}

model Indicator {
  id                          Int                @id @default(autoincrement())
  code                        String             @unique
  name                        String
  description                 String?
  unit                        String?
  baseline                    Float?
  midTarget                   Float?
  endTarget                   Float?
  frequency                   IndicatorFrequency @default(ANNUAL)
  source                      String?
  responsibility              String?
  department                  String?
  sector                      String?
  crop                        String?
  tags                        String[]
  dimensionConfig             Json?
  supportsDistrictBreakdown   Boolean            @default(false)
  supportsBlockBreakdown      Boolean            @default(false)
  supportsGenderBreakdown     Boolean            @default(false)
  supportsYouthBreakdown      Boolean            @default(false)
  supportsIndigenousBreakdown Boolean            @default(false)
  supportsHouseholdBreakdown  Boolean            @default(false)
  active                      Boolean            @default(true)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  logframeNodeId              Int
  logframeNode                LogframeNode       @relation(fields: [logframeNodeId], references: [id], onDelete: Cascade)
  yearlyProgress              IndicatorYearProgress[]
  surveyValues                SurveyIndicatorValue[]

  @@index([logframeNodeId])
  @@index([department])
  @@index([sector])
  @@index([crop])
  @@index([active])
}

model IndicatorYearProgress {
  id                        Int       @id @default(autoincrement())
  reportYear                Int
  annualTarget              Float?
  annualResult              Float?
  cumulativeTarget          Float?
  cumulativeResult          Float?
  maleValue                 Float?
  femaleValue               Float?
  youthValue                Float?
  indigenousValue           Float?
  householdValue            Float?
  womenHeadedHouseholdValue Float?
  bplValue                  Float?
  generalValue              Float?
  district                  String?
  block                     String?
  village                   String?
  dimensionValues           Json?
  evidenceSource            String?
  remarks                   String?
  reportingMonth            Int?
  lastReportedAt            DateTime?
  verifiedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  indicatorId               Int
  verifiedById              Int?
  indicator                 Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  verifiedBy                User?     @relation("IndicatorYearProgressVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([indicatorId, reportYear, district, block, village])
  @@index([indicatorId])
  @@index([reportYear])
  @@index([district])
}

// ─── NEW Models ───────────────────────────────────────────────────────────────

model Component {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  description   String?
  color         String?        @default("#15803d")
  sortOrder     Int            @default(0)
  active        Boolean        @default(true)
  subComponents SubComponent[]
  awpbLines     AWPBLine[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([sortOrder])
}

model SubComponent {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  componentId Int
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  schemes     Scheme[]
  awpbLines   AWPBLine[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([componentId])
  @@index([sortOrder])
}

// ─── AWPB Workflow Models ─────────────────────────────────────────────────────

model AWPB {
  id            Int           @id @default(autoincrement())
  title         String
  financialYear String
  district      String?
  department    String?
  status        AWPBStatus    @default(DRAFT)
  totalBudget   Float         @default(0)
  q1Budget      Float         @default(0)
  q2Budget      Float         @default(0)
  q3Budget      Float         @default(0)
  q4Budget      Float         @default(0)
  remarks       String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   Int?
  createdBy     User?         @relation("AWPBCreatedBy", fields: [createdById], references: [id])
  lines         AWPBLine[]
  history       AWPBHistory[]

  @@index([status])
  @@index([financialYear])
  @@index([district])
  @@index([createdById])
}

model AWPBLine {
  id             Int           @id @default(autoincrement())
  activityName   String
  unit           String?
  quantity       Float         @default(0)
  unitCost       Float         @default(0)
  totalCost      Float         @default(0)
  q1Target       Float         @default(0)
  q2Target       Float         @default(0)
  q3Target       Float         @default(0)
  q4Target       Float         @default(0)
  q1Budget       Float         @default(0)
  q2Budget       Float         @default(0)
  q3Budget       Float         @default(0)
  q4Budget       Float         @default(0)
  remarks        String?
  sortOrder      Int           @default(0)
  awpbId         Int
  componentId    Int?
  subComponentId Int?
  schemeId       Int?
  awpb           AWPB          @relation(fields: [awpbId], references: [id], onDelete: Cascade)
  component      Component?    @relation(fields: [componentId], references: [id], onDelete: SetNull)
  subComponent   SubComponent? @relation(fields: [subComponentId], references: [id], onDelete: SetNull)
  scheme         Scheme?       @relation(fields: [schemeId], references: [id], onDelete: SetNull)

  @@index([awpbId])
  @@index([componentId])
  @@index([schemeId])
}

model AWPBHistory {
  id         Int         @id @default(autoincrement())
  action     String
  fromStatus AWPBStatus?
  toStatus   AWPBStatus
  comments   String?
  createdAt  DateTime    @default(now())
  awpbId     Int
  userId     Int?
  awpb       AWPB        @relation(fields: [awpbId], references: [id], onDelete: Cascade)
  user       User?       @relation("AWPBHistoryUser", fields: [userId], references: [id])

  @@index([awpbId])
}

// ─── Survey Module (Baseline / Midline / Endline) ─────────────────────────────

enum SurveyRoundType {
  BASELINE
  MIDLINE
  ENDLINE
}

enum SurveyRoundStatus {
  DRAFT
  OPEN
  CLOSED
  CONFIRMED
}

enum SurveyResponseStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

model SurveyRound {
  id              Int                    @id @default(autoincrement())
  type            SurveyRoundType        @unique
  label           String
  year            Int
  description     String?
  targetCount     Int                    @default(0)
  status          SurveyRoundStatus      @default(DRAFT)
  openedAt        DateTime?
  closedAt        DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  responses       SurveyResponse[]
  indicatorValues SurveyIndicatorValue[]

  @@index([status])
  @@index([year])
}

model SurveyResponse {
  id                     Int                  @id @default(autoincrement())
  roundId                Int
  beneficiaryId          Int?
  beneficiaryUhid        String?
  localId                String?
  deviceId               String?
  fullName               String?
  district               String?
  block                  String?
  village                String?
  gender                 String?
  isYouth                Boolean              @default(false)
  isBpl                  Boolean              @default(false)
  category               String?
  annualIncome           Float?
  landHolding            Float?
  householdAssets        Json?
  cropData               Json?
  isFpoMember            Boolean?
  fpoName                String?
  fpoSalesIncrease       Boolean?
  fpoServicesRating      Int?
  satisfactionScore      Int?
  decisionInfluenceScore Int?
  remarks                String?
  status                 SurveyResponseStatus @default(DRAFT)
  submittedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  round                  SurveyRound          @relation(fields: [roundId], references: [id], onDelete: Cascade)
  beneficiary            Beneficiary?         @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)

  @@unique([roundId, localId])
  @@unique([roundId, beneficiaryId])
  @@index([roundId])
  @@index([district])
  @@index([block])
  @@index([status])
  @@index([beneficiaryUhid])
}

model SurveyIndicatorValue {
  id                Int         @id @default(autoincrement())
  roundId           Int
  indicatorId       Int
  computedValue     Float?
  reviewedValue     Float?
  reviewNotes       String?
  sampleSize        Int?
  unit              String?
  methodology       String?
  writtenToLogframe Boolean     @default(false)
  writtenAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  round             SurveyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  indicator         Indicator   @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([roundId, indicatorId])
  @@index([roundId])
  @@index([indicatorId])
}

// ─── MPR Auto-fetch Module ────────────────────────────────────────────────────

enum MprFetchStatus {
  SUCCESS
  PARTIAL   // some rows mapped, some skipped
  FAILED
}

// One row per fetch run per department
model MprFetchLog {
  id            Int            @id @default(autoincrement())
  department    String         // DAJ, DAK, DHJ, DHK, SHDJ, SHDK, HPM, FJK, AHDJ, AHDK, SKUASTJ, SKUASTK, PMU
  sheetId       String         // Google Sheets document ID
  tabName       String         // e.g. "Nov - 2025"
  reportMonth   String         // e.g. "2025-11"
  status        MprFetchStatus
  rowsFetched   Int            @default(0)  // total rows in CSV
  rowsMapped    Int            @default(0)  // rows matched to indicators
  rowsSkipped   Int            @default(0)  // rows with no indicator mapping
  conflictsFound Int           @default(0)
  errorMessage  String?
  triggeredBy   String         @default("scheduler") // "scheduler" or "manual"
  createdAt     DateTime       @default(now())

  conflicts     MprConflict[]

  @@index([department])
  @@index([reportMonth])
  @@index([status])
}

// When fetched value differs from existing MIS value — PMU must resolve
model MprConflict {
  id            Int       @id @default(autoincrement())
  department    String
  activityCode  String    // e.g. P02AN08
  activityName  String
  indicatorCode String    // e.g. OP22-SAFF
  reportMonth   String    // e.g. "2025-11"
  mprValue      Float     // value from Google Sheet
  misValue      Float     // value already in IndicatorYearProgress
  unit          String?
  resolution    String?   // "mpr" | "mis" | "override"
  resolvedValue Float?
  resolvedAt    DateTime?
  resolvedBy    Int?
  remarks       String?
  createdAt     DateTime  @default(now())

  fetchLogId    Int
  fetchLog      MprFetchLog @relation(fields: [fetchLogId], references: [id], onDelete: Cascade)
  resolver      User?     @relation("MprConflictResolver", fields: [resolvedBy], references: [id])

  @@index([fetchLogId])
  @@index([department])
  @@index([resolvedAt])
  @@index([indicatorCode])
}
