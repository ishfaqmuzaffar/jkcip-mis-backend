generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Existing Enums (unchanged) ───────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DEPARTMENT_OFFICER
  DATA_ENTRY
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SchemeStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  ON_HOLD
}

enum BeneficiaryStatus {
  IDENTIFIED
  VERIFIED
  APPROVED
  SUPPORTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LogframeLevel {
  OUTREACH
  GOAL
  DEVELOPMENT_OBJECTIVE
  OUTCOME
  OUTPUT
  SUB_OUTPUT
  INDICATOR_GROUP
}

enum IndicatorDirection {
  INCREASE
  DECREASE
  MAINTAIN
}

enum IndicatorFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  BIENNIAL
  MID_TERM
  END_TERM
  AD_HOC
}

enum LandType {
  OWNED
  LEASED
  SHARECROPPER
  COMMON_LAND
}

// ─── NEW Enums ────────────────────────────────────────────────────────────────

enum BeneficiaryCategory {
  GENERAL
  SC
  ST
  OBC
  PHH
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REVERTED
}
enum AWPBStatus {
  DRAFT
  PIU_REVIEW
  PMU_REVIEW
  IFAD_SUBMISSION
  IFAD_APPROVED
  DPC_APPROVED
  DAP_APPROVED
  REJECTED
  RETURNED
}


// ─── Existing Models (unchanged) ──────────────────────────────────────────────

model User {
  id                 Int                     @id @default(autoincrement())
  fullName           String
  email              String                  @unique
  password           String
  role               UserRole                @default(VIEWER)
  status             UserStatus              @default(ACTIVE)
  department         String?
  phone              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  createdSchemes     Scheme[]                @relation("SchemeCreatedBy")
  createdProjects    Project[]               @relation("ProjectCreatedBy")
  createdApprovals   Approval[]              @relation("ApprovalRequestedBy")
  reviewedApprovals  Approval[]              @relation("ApprovalReviewedBy")
  verifiedIndicators IndicatorYearProgress[] @relation("IndicatorYearProgressVerifiedBy")
  createdBeneficiaries Beneficiary[]         @relation("BeneficiaryCreatedBy")
  awpbs                AWPB[]                  @relation("AWPBCreatedBy")
  awpbHistory          AWPBHistory[]            @relation("AWPBHistoryUser")
}

// ─── Scheme (added subComponentId) ───────────────────────────────────────────

model Scheme {
  id                    Int           @id @default(autoincrement())
  title                 String
  code                  String        @unique
  description           String?
  department            String
  status                SchemeStatus  @default(DRAFT)
  budget                Float         @default(0)
  utilizedBudget        Float         @default(0)
  targetBeneficiaries   Int           @default(0)
  achievedBeneficiaries Int           @default(0)
  startDate             DateTime?
  endDate               DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  createdById           Int?
  subComponentId        Int?                          // ← NEW
  createdBy             User?         @relation("SchemeCreatedBy", fields: [createdById], references: [id])
  subComponent          SubComponent? @relation(fields: [subComponentId], references: [id], onDelete: SetNull) // ← NEW
  projects              Project[]
  beneficiaries         Beneficiary[]
  awpbLines             AWPBLine[]

  @@index([department])
  @@index([status])
  @@index([subComponentId])                          // ← NEW
}

model Project {
  id               Int           @id @default(autoincrement())
  name             String
  code             String        @unique
  description      String?
  department       String
  district         String?
  block            String?
  village          String?
  status           ProjectStatus @default(PLANNED)
  priority         PriorityLevel @default(MEDIUM)
  budget           Float         @default(0)
  utilizedBudget   Float         @default(0)
  targetCount      Int           @default(0)
  achievedCount    Int           @default(0)
  beneficiaryCount Int           @default(0)
  latitude         Float?
  longitude        Float?
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  schemeId         Int?
  createdById      Int?
  scheme           Scheme?       @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  createdBy        User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  beneficiaries    Beneficiary[]
  approvals        Approval[]

  @@index([department])
  @@index([district])
  @@index([status])
  @@index([priority])
}

// ─── Beneficiary (added category + applicationStatus) ─────────────────────────

model Beneficiary {
  id                Int                   @id @default(autoincrement())
  
  // ── Identity ──────────────────────────────────────────────────
  fullName          String
  uhid              String?               @unique  // JKCIP-2026-SRN-000001
  referenceNumber   String                @unique
  aadhaarNumber     String?               // for deduplication (masked in UI)
  gender            String?
  age               Int?
  phone             String?
  
  // ── Location ──────────────────────────────────────────────────
  district          String?
  block             String?
  village           String?
  latitude          Float?               // GPS capture
  longitude         Float?
  
  // ── Land Holding ──────────────────────────────────────────────
  landHolding       Float?               // hectares
  landType          LandType?
  khasraNumber      String?              // survey/khasra number
  
  // ── FPO Linkage ───────────────────────────────────────────────
  fpoName           String?
  fpoMemberId       String?
  
  // ── Classification ────────────────────────────────────────────
  isYouth           Boolean               @default(false)
  isWoman           Boolean               @default(false)
  isBpl             Boolean               @default(false)
  isGeneral         Boolean               @default(false)
  category          BeneficiaryCategory   @default(GENERAL)
  applicationStatus ApplicationStatus     @default(PENDING)
  status            BeneficiaryStatus     @default(IDENTIFIED)
  
  // ── Financial ─────────────────────────────────────────────────
  sanctionedAmount  Float                 @default(0)
  
  // ── Meta ──────────────────────────────────────────────────────
  remarks           String?
  importBatchId     String?              // track bulk imports
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  schemeId          Int?
  projectId         Int?
  createdById       Int?
  approvedAt        DateTime?
  
  // ── Relations ─────────────────────────────────────────────────
  scheme            Scheme?               @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy         User?                 @relation("BeneficiaryCreatedBy", fields: [createdById], references: [id])
  surveyResponses   SurveyResponse[]

  @@index([district])
  @@index([status])
  @@index([category])
  @@index([applicationStatus])
  @@index([uhid])
  @@index([aadhaarNumber])
  @@index([importBatchId])
  @@index([isYouth])
  @@index([isWoman])
  @@index([isBpl])
}


model Approval {
  id            Int            @id @default(autoincrement())
  title         String
  referenceNo   String         @unique
  entityType    String
  department    String
  status        ApprovalStatus @default(PENDING)
  priority      PriorityLevel  @default(MEDIUM)
  remarks       String?
  dueDate       DateTime?
  decisionAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  entityId      Int?
  projectId     Int?
  requestedById Int?
  reviewedById  Int?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedBy   User?          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  reviewedBy    User?          @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id])

  @@index([department])
  @@index([status])
  @@index([priority])
}

// ─── Logframe (unchanged) ─────────────────────────────────────────────────────

model LogframeNode {
  id          Int            @id @default(autoincrement())
  title       String
  code        String         @unique
  level       LogframeLevel
  description String?
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parentId    Int?
  parent      LogframeNode?  @relation("LogframeNodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    LogframeNode[] @relation("LogframeNodeHierarchy")
  indicators  Indicator[]

  @@index([level])
  @@index([parentId])
  @@index([sortOrder])
}

model Indicator {
  id                          Int                @id @default(autoincrement())
  code                        String             @unique
  name                        String
  description                 String?
  unit                        String?
  baseline                    Float?
  midTarget                   Float?
  endTarget                   Float?
  frequency                   IndicatorFrequency @default(ANNUAL)
  source                      String?
  responsibility              String?
  department                  String?
  sector                      String?
  crop                        String?
  tags                        String[]
  dimensionConfig             Json?
  supportsDistrictBreakdown   Boolean            @default(false)
  supportsBlockBreakdown      Boolean            @default(false)
  supportsGenderBreakdown     Boolean            @default(false)
  supportsYouthBreakdown      Boolean            @default(false)
  supportsIndigenousBreakdown Boolean            @default(false)
  supportsHouseholdBreakdown  Boolean            @default(false)
  active                      Boolean            @default(true)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  logframeNodeId              Int
  logframeNode                LogframeNode       @relation(fields: [logframeNodeId], references: [id], onDelete: Cascade)
  yearlyProgress              IndicatorYearProgress[]
  surveyValues                SurveyIndicatorValue[]

  @@index([logframeNodeId])
  @@index([department])
  @@index([sector])
  @@index([crop])
  @@index([active])
}

model IndicatorYearProgress {
  id                        Int       @id @default(autoincrement())
  reportYear                Int
  annualTarget              Float?
  annualResult              Float?
  cumulativeTarget          Float?
  cumulativeResult          Float?
  maleValue                 Float?
  femaleValue               Float?
  youthValue                Float?
  indigenousValue           Float?
  householdValue            Float?
  womenHeadedHouseholdValue Float?
  bplValue                  Float?
  generalValue              Float?
  district                  String?
  block                     String?
  village                   String?
  dimensionValues           Json?
  evidenceSource            String?
  remarks                   String?
  reportingMonth            Int?
  lastReportedAt            DateTime?
  verifiedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  indicatorId               Int
  verifiedById              Int?
  indicator                 Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  verifiedBy                User?     @relation("IndicatorYearProgressVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([indicatorId, reportYear, district, block, village])
  @@index([indicatorId])
  @@index([reportYear])
  @@index([district])
}

// ─── NEW Models ───────────────────────────────────────────────────────────────

model Component {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  description   String?
  color         String?        @default("#15803d")
  sortOrder     Int            @default(0)
  active        Boolean        @default(true)
  subComponents SubComponent[]
  awpbLines     AWPBLine[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([sortOrder])
}

model SubComponent {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  componentId Int
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  schemes     Scheme[]
  awpbLines   AWPBLine[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([componentId])
  @@index([sortOrder])
}

// ─── AWPB Workflow Models ─────────────────────────────────────────────────────

model AWPB {
  id            Int           @id @default(autoincrement())
  title         String
  financialYear String
  district      String?
  department    String?
  status        AWPBStatus    @default(DRAFT)
  totalBudget   Float         @default(0)
  q1Budget      Float         @default(0)
  q2Budget      Float         @default(0)
  q3Budget      Float         @default(0)
  q4Budget      Float         @default(0)
  remarks       String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   Int?
  createdBy     User?         @relation("AWPBCreatedBy", fields: [createdById], references: [id])
  lines         AWPBLine[]
  history       AWPBHistory[]

  @@index([status])
  @@index([financialYear])
  @@index([district])
  @@index([createdById])
}

model AWPBLine {
  id             Int           @id @default(autoincrement())
  activityName   String
  unit           String?
  quantity       Float         @default(0)
  unitCost       Float         @default(0)
  totalCost      Float         @default(0)
  q1Target       Float         @default(0)
  q2Target       Float         @default(0)
  q3Target       Float         @default(0)
  q4Target       Float         @default(0)
  q1Budget       Float         @default(0)
  q2Budget       Float         @default(0)
  q3Budget       Float         @default(0)
  q4Budget       Float         @default(0)
  remarks        String?
  sortOrder      Int           @default(0)
  awpbId         Int
  componentId    Int?
  subComponentId Int?
  schemeId       Int?
  awpb           AWPB          @relation(fields: [awpbId], references: [id], onDelete: Cascade)
  component      Component?    @relation(fields: [componentId], references: [id], onDelete: SetNull)
  subComponent   SubComponent? @relation(fields: [subComponentId], references: [id], onDelete: SetNull)
  scheme         Scheme?       @relation(fields: [schemeId], references: [id], onDelete: SetNull)

  @@index([awpbId])
  @@index([componentId])
  @@index([schemeId])
}

model AWPBHistory {
  id         Int         @id @default(autoincrement())
  action     String
  fromStatus AWPBStatus?
  toStatus   AWPBStatus
  comments   String?
  createdAt  DateTime    @default(now())
  awpbId     Int
  userId     Int?
  awpb       AWPB        @relation(fields: [awpbId], references: [id], onDelete: Cascade)
  user       User?       @relation("AWPBHistoryUser", fields: [userId], references: [id])

  @@index([awpbId])
}

// ─── Survey Module ────────────────────────────────────────────────────────────

enum SurveyRoundType {
  BASELINE
  MIDLINE
  ENDLINE
}

enum SurveyRoundStatus {
  DRAFT       // being configured, not yet open for data entry
  OPEN        // field staff can submit responses
  CLOSED      // data collection complete, computing aggregates
  CONFIRMED   // PMU reviewed and wrote values to logframe
}

enum SurveyResponseStatus {
  DRAFT       // saved locally / partially filled
  SUBMITTED   // synced to server
  VERIFIED    // reviewed by supervisor
}

// One row per survey round (max 3 rows in the project lifetime)
model SurveyRound {
  id            Int               @id @default(autoincrement())
  type          SurveyRoundType   @unique        // only one BASELINE, one MIDLINE, one ENDLINE
  label         String                           // e.g. "Baseline Survey 2024"
  year          Int                              // reference year
  status        SurveyRoundStatus @default(DRAFT)
  description   String?
  openedAt      DateTime?                        // when data collection started
  closedAt      DateTime?                        // when data collection ended
  confirmedAt   DateTime?                        // when PMU wrote to logframe
  targetCount   Int               @default(0)   // expected number of responses
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  responses     SurveyResponse[]
  indicatorValues SurveyIndicatorValue[]

  @@index([status])
  @@index([type])
}

// One row per beneficiary per round — stores all 4 form sections as JSON blobs
// plus key computed fields for quick aggregation
model SurveyResponse {
  id              Int                  @id @default(autoincrement())
  status          SurveyResponseStatus @default(DRAFT)

  // ── Beneficiary identity (denormalised for offline use) ─────────
  beneficiaryId   Int?                           // null until synced (offline)
  beneficiaryUhid String?                        // UHID for offline matching
  fullName        String?
  district        String?
  block           String?
  village         String?
  gender          String?
  isYouth         Boolean              @default(false)
  isBpl           Boolean              @default(false)
  category        String?              // SC/ST/OBC/GENERAL

  // ── Section 1: Household ────────────────────────────────────────
  // Income (INR/year), assets (0-5 scale), land holding (ha)
  annualIncome    Float?
  landHolding     Float?
  householdAssets Json?               // { livestock: true, tractor: false, ... }

  // ── Section 2: Crop ─────────────────────────────────────────────
  // Array of { crop, area_ha, yield_kg, productivity_kg_ha, marketed_grade }
  cropData        Json?

  // ── Section 3: FPO / PO ─────────────────────────────────────────
  isFpoMember     Boolean?
  fpoName         String?
  fpoSalesIncrease Boolean?           // did sales increase since last round?
  fpoServicesRating Int?              // 1-5

  // ── Section 4: Satisfaction (SF 2.1, SF 2.2) ───────────────────
  satisfactionScore       Int?        // 1-5 (SF 2.1)
  decisionInfluenceScore  Int?        // 1-5 (SF 2.2)

  // ── Device / sync metadata ──────────────────────────────────────
  deviceId        String?             // device identifier for offline tracking
  localId         String?             // UUID assigned offline before sync
  submittedAt     DateTime?           // when synced to server
  verifiedAt      DateTime?
  remarks         String?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  roundId         Int
  round           SurveyRound         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  beneficiary     Beneficiary?        @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)

  @@unique([roundId, beneficiaryId])  // one response per beneficiary per round
  @@unique([roundId, localId])        // offline dedup guard
  @@index([roundId])
  @@index([beneficiaryId])
  @@index([district])
  @@index([status])
  @@index([deviceId])
}

// Aggregated indicator values computed from responses when a round closes.
// PMU reviews these before they are written to Indicator.baseline / midTarget / endTarget.
model SurveyIndicatorValue {
  id              Int         @id @default(autoincrement())

  // The computed value for this indicator in this round
  computedValue   Float?
  unit            String?
  sampleSize      Int         @default(0)   // how many responses contributed
  methodology     String?                   // brief note on how value was derived

  // Disaggregations (mirroring IndicatorYearProgress structure)
  maleValue       Float?
  femaleValue     Float?
  youthValue      Float?
  indigenousValue Float?
  bplValue        Float?

  // PMU review
  reviewedValue   Float?                    // PMU may override the computed value
  reviewNotes     String?
  writtenToLogframe Boolean     @default(false)
  writtenAt       DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  roundId         Int
  indicatorId     Int

  round           SurveyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  indicator       Indicator   @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([roundId, indicatorId])
  @@index([roundId])
  @@index([indicatorId])
  @@index([writtenToLogframe])
}

